# Required
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# HTTP only. Comma-separated name:scope:secret or name:scope:sha256:<hex>.
# Scopes: read, member, manage, admin. Generate with: discord-mcp keygen <name> <scope>
MCP_KEYS=

# Optional
DISCORD_AUDIT_CHANNEL_ID=
DISCORD_PROTECTED_IDS=
DISCORD_READ_CHANNELS=
DISCORD_WRITE_CHANNELS=
DISCORD_ENABLE_ADMIN=true
DISCORD_ALLOW_DESTRUCTIVE=true
DISCORD_ALLOW_ADMINISTRATOR_PERMISSION=true
DISCORD_READ_ONLY=false
DISCORD_ALLOW_USER_MENTIONS=false

# stdio only
# MCP_STDIO_SCOPE=admin

# HTTP server
PORT=3000
HOST=127.0.0.1
